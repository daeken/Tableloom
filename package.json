{
  "name": "tableloom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "systems/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web 'npm run dev -w @tableloom/server' 'npm run dev -w @tableloom/web'",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test packages/core/src/*.test.ts apps/server/src/*.test.ts",
    "build": "npm run build -w @tableloom/web && npm run build -w @tableloom/server",
    "check": "npm run typecheck && npm test && npm run build && npm run smoke",
    "smoke": "node --import tsx scripts/smoke.ts",
    "format": "prettier --write .",
    "start": "node apps/server/dist/index.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.0.0",
    "fastify": "^5.0.0",
    "lucide-react": "^0.468.0",
    "pixi.js": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.0.0",
    "prettier": "^3.9.10",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.0",
    "vite": "^6.0.0",
    "ws": "^8.0.0"
  }
}
